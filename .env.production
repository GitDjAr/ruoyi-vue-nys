# 生产环境配置（vite build 默认加载，对应 pnpm build:prod）
# 公共配置见 .env
# 页面标题
VITE_APP_TITLE = 若依管理系统

VITE_APP_ENV = 'production'

# 生产环境：不启用 vite 代理，由 nginx 把 /prod-api 反代到后端
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli（需接入 vite-plugin-compression）
VITE_BUILD_COMPRESS = gzip

# 运行模式，可选 local（本地配置）或 remote（后端接口）
VITE_APP_RUNTIME_MODE = 'local'

